# Copy to .env and fill in values:
#   copy .env.example .env

# --- OpenAI (required for Streamlit UI / ask / RAG answer generation) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Embeddings (indexing + vector search) ---
# sentence_transformers = local, no API key needed (default)
# openai = requires OPENAI_API_KEY
EMBEDDING_BACKEND=sentence_transformers
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2

# --- Indexing batch sizes ---
# Posts per Chroma get()/upsert() round-trip
BATCH_SIZE=500
# Texts per embedding backend call (OpenAI request cap / ST forward-pass chunk)
EMBEDDING_ENCODE_BATCH_SIZE=64

# --- Hybrid retrieval + reranking ---
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_THRESHOLD=-2.0
HYBRID_ALPHA=0.5
RRF_K=60

# --- Chroma storage ---
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_PREFIX=posts

# --- SQL Server (StackOverflow2013) ---
DB_SERVER=localhost
DB_NAME=StackOverflow2013
DB_PORT=1433
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_USE_WINDOWS_AUTH=true
# Required when DB_USE_WINDOWS_AUTH=false:
# DB_USER=
# DB_PASSWORD=

# Rows fetched per --all batch (outer SQL loop)
DB_LIMIT=10000
DB_CONNECTION_TIMEOUT=60
DB_QUERY_TIMEOUT=600
DB_FETCH_SIZE=500

# --- Paths ---
WATERMARK_PATH=./data/watermark.json
LOG_DIR=./logs
DLQ_PATH=./rejected_records.jsonl

# Optional: override default question-post query (must include LastActivityDate for incremental mode)
# DB_QUERY=SELECT Id, Title, Body, Tags, LastActivityDate FROM Posts WHERE PostTypeId = 1 ORDER BY Id
